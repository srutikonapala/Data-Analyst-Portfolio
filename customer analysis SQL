SELECT c.Name, SUM(o.price*o.quantity) AS Total_revenue 
FROM Customers as c
INNER JOIN  Orders as o
ON c.customer_id = o.customer_id
GROUP BY c.Name;

SELECT c.Name, COUNT(o.orderID) AS Total_orders 
FROM Customers as c
INNER JOIN Orders as o
ON c.customer_id = o.customer_id
GROUP BY c.Name;

SELECT c.Name, AVG(o.price*o.quantity) AS Average_revenue
 FROM Customers as c
INNER JOIN Orders as o
ON c.customer_id = o.customer_id 
GROUP BY c.Name;

SELECT c.name, SUM(o.price*o.quantity) AS Total_revenue 
FROM Customers as c
INNER JOIN Orders as o
 ON c.customer_id = o.customer_id 
 GROUP BY c.Name
 ORDER BY Total_revenue DESC
 LIMIT 3;

SELECT MONTH(OrderDate), sum(price*quantity) AS Total_revenue
 FROM Orders
GROUP BY MONTH(OrderDate)
ORDER BY MONTH(OrderDate) ASC;

SELECT category, sum(price*quantity) AS Revenue
 FROM Orders
GROUP BY category
ORDER BY Revenue DESC;








